# Copy to ".env" and fill in your Supabase project values.
# Find these in the Supabase dashboard → Project Settings → API.
# Leave BOTH unset to run the app in in-memory demo mode (no backend).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Invite-only: set to "true" to hide self-signup from the login screen. The
# REAL enforcement is the "Disable signup" toggle in Supabase (Authentication →
# Sign In / Providers); with it off, Google can't create accounts either.
VITE_DISABLE_SIGNUP=

# Billing: leave blank/false during free testing — no trial countdown, no
# paywall, everyone has full access after signing up. Set to "true" to turn the
# 7-day trial + Stripe paywall back on.
VITE_BILLING_ENABLED=

# Push notifications: the PUBLIC VAPID key (docs/integrations/push.md). Safe to
# ship to browsers; the private key lives only in Supabase's function secrets.
# Leave blank and the Push section stays hidden.
VITE_VAPID_PUBLIC_KEY=

# Sign in with Google: "true" builds the button in. It still only shows once
# Supabase reports the Google provider on AND "Confirm email" on
# (docs/integrations/google-sign-in.md). VITE_GOOGLE_HD: a company domain for
# Google's account chooser, or "off"; unset = the one auto-approved domain.
VITE_ENABLE_GOOGLE=
VITE_GOOGLE_HD=

# Error monitoring (Sentry). Leave blank to switch it off. TRACES_RATE: 0–1,
# the share of page loads that are timed. APP_ENV: optional, falls back to
# Vercel's environment (set "production" for Production only).
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_RATE=
VITE_APP_ENV=
